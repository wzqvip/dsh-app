{
  "name": "dsh-efficiency",
  "version": "0.0.1",
  "private": true,
  "description": "效率导向的 DeepSeek Harness 增强：不打开浏览器也能收到 agent 提问并一键回答，随时看到进度。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "test:placement": "node scripts/test-placement.mjs",
    "test": "node scripts/smoke-client.mjs && node scripts/test-placement.mjs",
    "check": "node scripts/build.mjs && node scripts/smoke-client.mjs && node scripts/test-placement.mjs",
    "deploy": "node scripts/deploy.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:all": "node scripts/build-vendor.mjs && node scripts/build-host.mjs && node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  }
}
