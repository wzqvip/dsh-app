# 依赖与构建产物
node_modules/
dist/
lib/
*.tsbuildinfo
.pnpm-store/

# 调研快照：5 MB 的社区插件目录 dump，可随时用 curl 重新获取，不入库
#   curl -sf https://awesome-dsh-plugin.com/plugins.json -o research/registry-snapshot.json
# 需要留档时注释掉下一行
research/registry-snapshot.json

# 本地备份（profile 配置备份，见 todo.md P0-1）
backup/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
npm-debug.log*
pnpm-debug.log*
*.tmp

# 重启流程的日志与临时输出
restart-dsh.log
restart-dsh.stdout.log
restart-dsh.stderr.log

# 提交信息临时文件
commit-msg.tmp

# 凭据与密钥（绝不可入库）
.credentials.yaml
*.credentials.yaml
.env
.env.*

# 插件构建产物
packages/*/lib/

# 发布产物（由 npm run deploy 生成）
# ⚠️ release/ 整体不入库：它 = vendor/ 源码 + lib/ + 构建脚本的拷贝，全部可从仓库重建；
#    入库会把这 60 MB 素材**再存一份**（vendor/dsh-pet/assets 已有一份）。
#    与 packages/*/lib/ 同一原则：产物不入库，克隆后跑 `npm run deploy` 生成。
packages/*/release/
# vendored 上游代码：只带源码，不带其构建产物与依赖
packages/*/vendor/*/node_modules/
packages/*/vendor/*/lib/

# vendor 转译产物（由 scripts/build-vendor.mjs 生成）
packages/*/build/

